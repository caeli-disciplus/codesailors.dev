---
layout: layout.njk
title: "Case Notes - CodeSailors.dev"
permalink: /posts/
---

<section class="page-header posts-header">
    <div class="container">
        <h2 class="page-title">Case Notes</h2>
        <div class="page-divider"></div>
        <p class="page-subtitle">Case notes and fixes — what broke in real AI-assisted projects and how it was solved.</p>
    </div>
</section>

<section class="posts-archive">
    <div class="container">
        <div class="posts-grid full-width">
            {% if collections.posts | length > 0 %}
                {% for post in collections.posts | reverse %}
                <article class="post-card full-post">
                    <div class="post-header">
                        <span class="post-date">{{ post.date | dateLong }}</span>
                        <span class="post-category" style="--category-color: {{ post.data.categoryColor }};">{{ post.data.categoryFull }}</span>
                    </div>
                    <div class="post-content">
                        <h3 class="post-title">{{ post.data.title }}</h3>
                        <p class="post-excerpt">{{ post.data.excerpt }}</p>
                        <a href="{{ post.url }}" class="read-more-link">Read Full Article</a>
                    </div>
                    <div class="post-footer">
                        <span class="post-time">{{ post.data.readTime }}</span>
                    </div>
                </article>
                {% endfor %}
            {% else %}
                <p class="no-posts-message">No posts yet — check back soon.</p>
            {% endif %}
        </div>
    </div>
</section>
